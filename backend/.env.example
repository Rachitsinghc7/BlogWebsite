# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.

PORT=5000

# Get a free connection string from MongoDB Atlas (atlas.mongodb.com)
# or use a local Mongo instance: mongodb://127.0.0.1:27017/blogsphere
MONGO_URI=mongodb://127.0.0.1:27017/blogsphere

# URL where your frontend runs (for CORS). Adjust if different.
CLIENT_ORIGIN=http://127.0.0.1:5500
